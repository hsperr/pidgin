.DS_Store
.pytest_cache/
.ruff_cache/
__pycache__/
*.py[cod]

# Training output and checkpoints stay local; weights are published separately.
runs/
results/
*.pt

# Private working notes for the project story.
project-story-raw.md

# Deal datasets. The tiny deterministic test fixture is the one exception.
data/*
!data/smoke_128.npz

# Credentials must never land here.
.env*
*.pem
*.key
id_rsa*

# DDS writes this at the repo root when a solve fails.
dump.txt

# Local solver experiments and assistant configuration are outside the public package.
dd/
.claude/
.venv/
build/
dist/
*.egg-info/

# Generated training data for belief/ and qnet/ (rebuild with their generators).
belief/data/*
!belief/data/systems.json
qnet/auc/
qnet/pos/
qnet/*.log
